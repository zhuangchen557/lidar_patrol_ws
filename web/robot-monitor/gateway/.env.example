ROSBRIDGE_URL=ws://127.0.0.1:9090
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ROBOT_CONTROL_PASSWORD=replace-with-a-team-password

ROS_TOPIC_TEMPERATURE=/sensor/temperature
ROS_TOPIC_HUMIDITY=/sensor/humidity
ROS_TOPIC_TEMP_HUM=/sensor/temp_hum
ROS_TOPIC_NOISE=/sensor/noise
ROS_TOPIC_ODOM=/odom
ROS_TOPIC_BATTERY=/battery_state
ROS_TOPIC_MISSION_STATE=/patrol/state
ROS_TOPIC_COMMAND=/patrol/command
